{
  "name": "IoT",
  "version": "2.0.0",
  "description": "IoT platform - dashboard + firmware",
  "private": true,
  "scripts": {
    "start":     "cd dashboard && node server.js",
    "dev":       "cd dashboard && node server.js",
    "test":      "cd dashboard && npm test",
    "cloudflare": "node server/cloudflare-tunnel.js",
    "server": "node server/share-tunnel.js",
    "server:check": "node server/check-server.js",
    "server:cloudflare": "node server/cloudflare-tunnel.js",
    "server:diagnose": "node server/diagnose-vps.js",
    "share:vps": "node server/share-tunnel.js",
    "android:build": "cd firmware/android && gradlew.bat :app:assembleRelease",
    "android:install": "powershell -ExecutionPolicy Bypass -File firmware/android/install-apk.ps1",
    "android:devices": "adb devices -l"
  },
  "workspaces": ["dashboard"]
}
