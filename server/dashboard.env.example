NODE_ENV=production
PORT=3000
ANDROID_BRIDGE_PUBLIC_URL=
PUBLIC_BRIDGE_BASE_URL=
SOCKET_IO_CORS_ORIGIN=

# Set real secrets only on the Ubuntu server, never commit them.
SESSION_SECRET=change-this-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@example.com

MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_PROTOCOL=mqtt
MQTT_USER=
MQTT_PASSWORD=
MQTT_CLIENT_ID=dashboard-device-atebd
MQTT_REJECT_UNAUTHORIZED=false

PHONE_COUNTRY_CODE=880
TZ=Asia/Dhaka
LOG_LEVEL=info
